generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  OWNER
  ADMIN
  STAFF
  TRAINER
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  FROZEN
}

enum AttendanceSource {
  QR
  RFID
  BIOMETRIC
  MANUAL
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_TIME
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  CASH
  BANK_TRANSFER
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ContactMethod {
  PHONE
  EMAIL
  SMS
  WHATSAPP
}

enum IdProofType {
  AADHAAR
  PASSPORT
  DRIVING_LICENSE
  VOTER_ID
  OTHER
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum FitnessGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  STRENGTH
  ENDURANCE
  REHAB
  GENERAL_FITNESS
}

enum FreezeReason {
  MEDICAL
  TRAVEL
  PERSONAL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  TRIAL
  CONVERTED
  LOST
}

enum LeadSource {
  WALK_IN
  WEBSITE
  INSTAGRAM
  REFERRAL
  PHONE
  OTHER
}

enum DietGoal {
  FAT_LOSS
  MUSCLE_GAIN
  MAINTENANCE
  PERFORMANCE
}

enum PtSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/** A physical location under one club. Members, staff and classes belong to a branch. */
model Branch {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  addressLine String?
  city        String?
  phone       String?
  openingHours String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  members Member[]
  users   User[]
  classes GymClass[]
  leads   Lead[]

  @@unique([tenantId, name])
  @@map("branches")
}

/** Someone who has enquired but not yet joined — the front of the funnel. */
model Lead {
  id                String     @id @default(cuid())
  tenantId          String
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId          String?
  branch            Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  firstName         String
  lastName          String
  phone             String
  email             String?
  source            LeadSource @default(WALK_IN)
  status            LeadStatus @default(NEW)
  interestedPlanId  String?
  interestedPlan    MembershipPlan? @relation(fields: [interestedPlanId], references: [id], onDelete: SetNull)
  assignedTrainerId String?
  assignedTrainer   User?      @relation("LeadTrainer", fields: [assignedTrainerId], references: [id], onDelete: SetNull)
  notes             String?
  followUpAt        DateTime?
  convertedMemberId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([tenantId, status])
  @@map("leads")
}

/** A nutrition plan a trainer sets for a member. Meals are a JSON list so the shape can evolve. */
model DietPlan {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainerId     String?
  trainer       User?    @relation("DietTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  title         String
  goal          DietGoal @default(MAINTENANCE)
  dailyCalories Int?
  proteinG      Int?
  carbsG        Int?
  fatG          Int?
  meals         Json
  notes         String?
  startDate     DateTime @default(now())
  endDate       DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([memberId, isActive])
  @@map("diet_plans")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  subdomain String   @unique
  logoUrl   String?
  colors    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  members          Member[]
  membershipPlans  MembershipPlan[]
  classes          GymClass[]
  attendanceEvents AttendanceEvent[]
  branches         Branch[]
  leads            Lead[]

  @@map("tenants")
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         StaffRole @default(STAFF)
  phone        String?
  specialty    String?
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  trainerBookings Booking[]    @relation("TrainerBookings")
  assignedMembers Member[]     @relation("AssignedMembers")
  ptPackages      PtPackage[]  @relation("TrainerPackages")
  ptSessions      PtSession[]  @relation("TrainerSessions")
  authoredNotes   MemberNote[] @relation("AuthoredNotes")
  leads           Lead[]       @relation("LeadTrainer")
  dietPlans       DietPlan[]   @relation("DietTrainer")

  @@unique([tenantId, email])
  @@map("users")
}

model Member {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // Identity & contact
  firstName        String
  lastName         String
  email            String
  phone            String?
  alternatePhone   String?
  dateOfBirth      DateTime?
  gender           Gender?
  occupation       String?
  preferredContact ContactMethod @default(PHONE)
  photoUrl         String?

  addressLine String?
  city        String?
  state       String?
  postalCode  String?

  // Identity proof. The full number is deliberately NOT stored — holding complete
  // Aadhaar/passport numbers is a DPDP-Act liability. Staff verify against the
  // uploaded document; the last 4 digits are enough to match it to a record.
  idProofType   IdProofType?
  idProofLast4  String?
  idProofDocUrl String?

  // Emergency contact
  emergencyName         String?
  emergencyRelationship String?
  emergencyPhone        String?

  // Medical / safety screening
  medicalConditions      String?
  allergies              String?
  medications            String?
  injuries               String?
  physicianClearance     Boolean   @default(false)
  physicianClearanceDate DateTime?
  parqCompletedAt        DateTime?
  waiverSignedAt         DateTime?

  // Fitness profile
  primaryGoal     FitnessGoal?
  experienceLevel ExperienceLevel?
  heightCm        Float?

  // Training relationship
  assignedTrainerId String?
  assignedTrainer   User?   @relation("AssignedMembers", fields: [assignedTrainerId], references: [id], onDelete: SetNull)

  // Access control
  accessCardNumber String?
  accessBlocked    Boolean @default(false)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions    Subscription[]
  attendanceEvents AttendanceEvent[]
  bookings         Booking[]
  measurements     BodyMeasurement[]
  ptPackages       PtPackage[]
  ptSessions       PtSession[]
  memberNotes      MemberNote[]
  dietPlans        DietPlan[]

  @@unique([tenantId, email])
  @@index([tenantId, assignedTrainerId])
  @@index([tenantId, branchId])
  @@map("members")
}

model BodyMeasurement {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recordedAt DateTime @default(now())

  weightKg       Float?
  bodyFatPercent Float?
  chestCm        Float?
  waistCm        Float?
  hipsCm         Float?
  armCm          Float?
  thighCm        Float?
  notes          String?

  @@index([memberId, recordedAt])
  @@map("body_measurements")
}

model PtPackage {
  id        String @id @default(cuid())
  memberId  String
  member    Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainerId String?
  trainer   User?  @relation("TrainerPackages", fields: [trainerId], references: [id], onDelete: SetNull)

  sessionsPurchased Int
  priceCents        Int
  currency          String    @default("INR")
  purchasedAt       DateTime  @default(now())
  expiresAt         DateTime?

  sessions PtSession[]

  @@index([memberId])
  @@map("pt_packages")
}

model PtSession {
  id        String    @id @default(cuid())
  packageId String
  package   PtPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainerId String?
  trainer   User?     @relation("TrainerSessions", fields: [trainerId], references: [id], onDelete: SetNull)

  scheduledAt     DateTime
  durationMinutes Int             @default(60)
  status          PtSessionStatus @default(SCHEDULED)
  completedAt     DateTime?
  focus           String?
  notes           String?

  @@index([memberId, scheduledAt])
  @@index([trainerId, scheduledAt])
  @@map("pt_sessions")
}

model MemberNote {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?  @relation("AuthoredNotes", fields: [authorId], references: [id], onDelete: SetNull)

  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
  @@map("member_notes")
}

model SubscriptionFreeze {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime
  reason    FreezeReason @default(OTHER)
  note      String?
  createdAt DateTime     @default(now())

  @@index([subscriptionId])
  @@map("subscription_freezes")
}

model MembershipPlan {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  priceCents    Int
  currency      String       @default("INR")
  billingCycle  BillingCycle @default(MONTHLY)
  isActive      Boolean      @default(true)
  ptSessionsIncluded Int     @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  subscriptions Subscription[]
  leads         Lead[]

  @@map("membership_plans")
}

model Subscription {
  id               String             @id @default(cuid())
  memberId         String
  member           Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membershipPlanId String
  membershipPlan   MembershipPlan     @relation(fields: [membershipPlanId], references: [id])
  status           SubscriptionStatus @default(ACTIVE)
  startDate        DateTime           @default(now())
  currentPeriodEnd DateTime
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  payments Payment[]
  freezes  SubscriptionFreeze[]

  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(cuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amountCents    Int
  currency       String         @default("INR")
  status         PaymentStatus  @default(PENDING)
  method         PaymentMethod?
  provider       String         @default("mock")
  providerRef    String?
  invoiceNumber  String?
  note           String?
  dueAt          DateTime?
  paidAt         DateTime?
  createdAt      DateTime       @default(now())

  @@map("payments")
}

model AttendanceEvent {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  source       AttendanceSource @default(QR)
  checkedInAt  DateTime         @default(now())

  @@index([tenantId, checkedInAt])
  @@map("attendance_events")
}

model GymClass {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  trainerId   String?
  name        String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int      @default(20)
  createdAt   DateTime @default(now())

  bookings Booking[]

  @@map("gym_classes")
}

model Booking {
  id         String   @id @default(cuid())
  gymClassId String
  gymClass   GymClass @relation(fields: [gymClassId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainerId  String?
  trainer    User?    @relation("TrainerBookings", fields: [trainerId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([gymClassId, memberId])
  @@map("bookings")
}
